+    def _load_fp8_hf_weight(self, name: str, state: Mapping[str, torch.Tensor]) -> torch.Tensor:
+        weight = state[name]
+        if not is_fp8_tensor(weight):
+            return weight
+        config = getattr(self.hf_pretrained, "config", self.hf_pretrained)
+        quantization = getattr(config, "quantization_config", None) or {}
+        block_size = quantization.get("weight_block_size", [128, 128])
+        if block_size not in ([128, 128], (128, 128)):
+            raise ValueError(f"Qwen4-Exp FP8 import requires weight_block_size=[128, 128], got {block_size}")
+        scale_name = f"{name}_scale_inv"
+        if scale_name not in state:
+            raise ValueError(f"FP8 weight {name} requires {scale_name}")
+        scale = state[scale_name]
+        expected = tuple((dim + 127) // 128 for dim in weight.shape)
+        if weight.ndim != 2 or tuple(scale.shape) != expected:
+            raise ValueError(
+                f"{scale_name}: expected a 2D block scale of shape {expected}, got {tuple(scale.shape)}"
+            )
+        if not scale.is_floating_point() or not torch.isfinite(scale).all() or not (scale > 0).all():
+            raise ValueError(f"{scale_name}: scales must be finite positive floating-point values")
+        return dequantize_fp8_blockwise(weight, scale.float(), dtype=torch.float32)
